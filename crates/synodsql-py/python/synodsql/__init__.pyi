from collections.abc import Iterable, Sequence
from typing import Any, Optional, Union

__version__: str

class Error(Exception): ...

RowId = Union[str, bytes]

class Database:
    @staticmethod
    def create(
        path: str,
        node: int,
        *,
        epoch_ms: int = 60000,
        lateness: int = 16,
        genesis_ms: int = 0,
        max_drift_ms: int = 500,
    ) -> Database: ...
    @staticmethod
    def open(path: str) -> Database: ...
    @property
    def path(self) -> str: ...
    @property
    def node(self) -> int: ...
    @property
    def serving(self) -> bool: ...
    def create_table(self, ddl: str) -> str: ...
    def insert(self, table: str, values: Optional[dict[str, Any]] = None, **kwargs: Any) -> str: ...
    def update(self, table: str, row_id: RowId, values: Optional[dict[str, Any]] = None, **kwargs: Any) -> None: ...
    def delete(self, table: str, row_id: RowId) -> None: ...
    def query(self, sql: str, params: Optional[Iterable[Any]] = None) -> list[tuple[Any, ...]]: ...
    def query_dicts(self, sql: str, params: Optional[Iterable[Any]] = None) -> list[dict[str, Any]]: ...
    def exec(self, *args: str) -> str: ...
    def seal(self) -> list[int]: ...
    def export(self, epoch: int) -> bytes: ...
    def merge(self, logs: Sequence[bytes]) -> list[int]: ...
    def clone_to(self, path: str, node: int) -> Database: ...
    def serve(
        self,
        listen: str,
        peers: Sequence[tuple[int, str]],
        certs: str,
        *,
        tick_ms: Optional[int] = None,
        quorum: bool = True,
        gossip: Optional[int] = None,
    ) -> None: ...
    def close(self) -> None: ...
    def __enter__(self) -> Database: ...
    def __exit__(self, *exc: Any) -> bool: ...

def make_certs(dir: str, nodes: Sequence[int], clients: Sequence[str] = ...) -> int: ...
def remote(addr: str, node: int, certs: str, *args: str, name: str = "admin") -> str: ...
def row_id_str(id: RowId) -> str: ...
